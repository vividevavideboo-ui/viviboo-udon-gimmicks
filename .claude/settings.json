{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)",
      "Bash(find:*)"
    ],
    "deny": [
      "Write(**/*.prefab)",
      "Write(**/*.unity)",
      "Edit(**/*.prefab)",
      "Edit(**/*.unity)"
    ]
  }
}
